# Electron dependencies — install with: cd ui && npm install
ui/node_modules/

# Python virtual environment
.venv/

# Runtime data — the directory is tracked, its contents are not
data/*
!data/.gitkeep
# User-generated files stay local and are never included in normal Git staging.
/CreatedFolder/
*.db
*.log

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment variables
.env

# OS files
.DS_Store
Thumbs.db
